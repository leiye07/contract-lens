{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "clause_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Clause Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 1200,
          "minLength": 12,
          "title": "Quote",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "clause_id",
        "quote",
        "document_id",
        "document_version",
        "document_sha256",
        "char_start",
        "char_end"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "citations"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "finding": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "clause_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Clause Ids",
          "type": "array"
        }
      },
      "required": [
        "topic",
        "finding",
        "clause_ids"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "PlanInput": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "description": "Concise investigation steps; batch related retrieval and reserve reporting calls.",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "PlanInput",
      "type": "object"
    },
    "SourceClause": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "document_sha256": {
          "title": "Document Sha256",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "document_id",
        "document_title",
        "document_version",
        "document_sha256",
        "section",
        "title",
        "text",
        "char_start",
        "char_end"
      ],
      "title": "SourceClause",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "model_calls"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "artifact_type": {
      "const": "contract_report",
      "default": "contract_report",
      "title": "Artifact Type",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "conclusion_status": {
      "enum": [
        "supported",
        "qualified",
        "conflicting",
        "insufficient_evidence"
      ],
      "title": "Conclusion Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 8,
      "title": "Findings",
      "type": "array"
    },
    "conditions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Conditions",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Gaps",
      "type": "array"
    },
    "review_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Review Questions",
      "type": "array"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "package_sha256": {
      "title": "Package Sha256",
      "type": "string"
    },
    "evidence_ledger": {
      "items": {
        "$ref": "#/$defs/LedgerEntry"
      },
      "maxItems": 24,
      "title": "Evidence Ledger",
      "type": "array"
    },
    "source_clauses": {
      "items": {
        "$ref": "#/$defs/SourceClause"
      },
      "maxItems": 40,
      "title": "Source Clauses",
      "type": "array"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/PlanInput"
      },
      "maxItems": 8,
      "title": "Plans",
      "type": "array"
    },
    "model_usage": {
      "$ref": "#/$defs/Usage"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "question",
    "conclusion_status",
    "findings",
    "conditions",
    "gaps",
    "review_questions",
    "package_id",
    "package_sha256",
    "evidence_ledger",
    "source_clauses",
    "plans",
    "model_usage",
    "versions"
  ],
  "title": "ContractReport",
  "type": "object"
}
