MODEL_EXECUTION_ENABLED=false
# Set an explicit supported provider model identifier; no moving default is chosen.
CONTRACTLENS_MODEL=
# Mount secrets/demo_token (random 32+ characters) and secrets/anthropic_api_key.
# The sandbox receives only the scoped demo token, never the provider key.

# anthropic (default) or openrouter; use an explicit provider-qualified model for OpenRouter.
MODEL_PROVIDER=anthropic

# Per-run execution budgets (independent of hourly/session admission quotas).
CONTRACTLENS_BUDGET_MODEL_CALLS=24
CONTRACTLENS_BUDGET_TOOL_CALLS=40
CONTRACTLENS_BUDGET_TIMEOUT_SECONDS=300
CONTRACTLENS_BUDGET_CONTEXT_BYTES=160000
CONTRACTLENS_BUDGET_OUTPUT_TOKENS=4096
CONTRACTLENS_BUDGET_REQUEST_TIMEOUT_SECONDS=30
CONTRACTLENS_BUDGET_RESPONSE_BYTES=128000
CONTRACTLENS_BUDGET_TOOL_INPUT_BYTES=16000
CONTRACTLENS_BUDGET_EVIDENCE_EVENTS=320
CONTRACTLENS_BUDGET_EVIDENCE_PAYLOAD_BYTES=24000
CONTRACTLENS_BUDGET_PLAN_REVISIONS=8
CONTRACTLENS_BUDGET_LEDGER_ENTRIES=24
CONTRACTLENS_BUDGET_TOOLS_PER_TURN=6
