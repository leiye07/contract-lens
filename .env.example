MODEL_EXECUTION_ENABLED=false
# Set an explicit supported provider model identifier; no moving default is chosen.
CONTRACTLENS_MODEL=
# Mount secrets/demo_token (random 32+ characters) and secrets/anthropic_api_key.
# The sandbox receives only the scoped demo token, never the provider key.

# anthropic (default) or openrouter; use an explicit provider-qualified model for OpenRouter.
MODEL_PROVIDER=anthropic
